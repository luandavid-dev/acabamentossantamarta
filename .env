# Copie para .env e ajuste antes de iniciar em produção.
SECRET_KEY=troque-por-uma-chave-com-mais-de-32-caracteres
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Primeiro admin apenas se o banco estiver vazio de administradores.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.local
ADMIN_INITIAL_PASSWORD=troque-esta-senha

# ERP / SQL Server.
ERP_ODBC_DRIVER=ODBC Driver 17 for SQL Server
ERP_DB_SERVER=servidor-ou-ip
ERP_DB_NAME=BDENTER
ERP_DB_USER=usuario
ERP_DB_PASSWORD=senha

